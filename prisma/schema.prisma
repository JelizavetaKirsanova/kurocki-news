datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  slug      String?  @unique
  content   String
  imageUrl  String?
  videoUrl  String?
  createdAt DateTime @default(now())
}